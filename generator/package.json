{
  "name": "sd-excalidraw-kit-generator",
  "version": "1.3.0",
  "private": true,
  "description": "Generates the System Design & AI Architecture Kit .excalidrawlib from code",
  "license": "MIT",
  "scripts": {
    "bundle": "esbuild src/main.js --bundle --format=iife --outfile=www/bundle.js --define:process.env.NODE_ENV='\"production\"' --loader:.css=empty",
    "build": "npm run bundle && node run.cjs",
    "sheets": "node sheet.cjs"
  },
  "dependencies": {
    "@excalidraw/excalidraw": "0.18.1",
    "react": "18.3.1",
    "react-dom": "18.3.1"
  },
  "devDependencies": {
    "esbuild": "0.24.0",
    "playwright": "1.48.2"
  }
}
